      "parameters": {
        "jsCode": "\n// ---------------------------------------------------------------------------\n// Normalizes whatever the user pasted into a clean OpenRouter request payload.\n// Handles: /review command, inline flags, fenced code blocks, language\n// sniffing, truncation guards, and empty-input detection.\n// ---------------------------------------------------------------------------\n\nconst cfg = $('Config').first().json;\nconst trigger = $('Telegram Trigger').first().json;\nconst msg = trigger.message || {};\nconst rawText = (msg.text || msg.caption || '').toString();\n\n// Strip a leading /review command, with or without a @botname suffix.\nlet body = rawText.replace(/^\\/review(@[A-Za-z0-9_]+)?\\s*/i, '').trim();\n\n// Inline flags let the reviewer change behaviour without editing the workflow.\nconst flags = { depth: 'standard', focus: 'general', language: '' };\nbody = body.replace(/--deep\\b/gi, () => { flags.depth = 'deep'; return ''; });\nbody = body.replace(/--quick\\b/gi, () => { flags.depth = 'quick'; return ''; });\nbody = body.replace(/--security\\b/gi, () => { flags.focus = 'security'; return ''; });\nbody = body.replace(/--perf\\b/gi, () => { flags.focus = 'performance'; return ''; });\nbody = body.replace(/--lang=([A-Za-z0-9+#._-]+)/gi, (m, g) => { flags.language = g.toLowerCase(); return ''; });\nbody = body.trim();\n\n// Prefer the contents of a fenced block when one is present.\nlet language = flags.language;\nlet code = body;\nconst fence = body.match(/```([A-Za-z0-9+#._-]*)[^\\S\\n]*\\n([\\s\\S]*?)```/);\nif (fence) {\n  if (!language && fence[1]) language = fence[1].toLowerCase();\n  code = fence[2];\n}\ncode = code.replace(/\\s+$/, '');\n\n// Cheap heuristics so the prompt can state a language even when none is given.\nif (!language) {\n  const sniff = [\n    [/^\\s*package\\s+[\\w.]+;|public\\s+(static\\s+)?(class|void)\\s+\\w+/m, 'java'],\n    [/^\\s*def\\s+\\w+\\s*\\(|^\\s*from\\s+[\\w.]+\\s+import\\b|^\\s*elif\\b/m, 'python'],\n    [/^\\s*func\\s+\\w+\\s*\\(|^\\s*package\\s+main\\b/m, 'go'],\n    [/^\\s*fn\\s+\\w+\\s*\\(|\\blet\\s+mut\\b|->\\s*Result</m, 'rust'],\n    [/<\\?php/, 'php'],\n    [/^\\s*(interface|type)\\s+\\w+\\s*(=|\\{)|:\\s*(string|number|boolean)\\b/m, 'typescript'],\n    [/^\\s*(SELECT|INSERT\\s+INTO|UPDATE|DELETE\\s+FROM|CREATE\\s+TABLE)\\b/im, 'sql'],\n    [/^#!.*\\b(ba)?sh\\b|^\\s*(fi|esac|done)\\s*$/m, 'bash'],\n    [/\\b(const|let|var)\\b|=>|function\\s*\\(/, 'javascript'],\n  ];\n  for (const pair of sniff) {\n    if (pair[0].test(code)) { language = pair[1]; break; }\n  }\n}\nif (!language) language = 'unknown';\n\nconst lineCount = code ? code.split('\\n').length : 0;\nconst maxChars = Number(cfg.maxCodeChars) || 12000;\nlet truncated = false;\nif (code.length > maxChars) {\n  code = code.slice(0, maxChars);\n  truncated = true;\n}\n\n// Anything shorter than this is almost certainly chat, not code.\nconst ok = code.trim().length >= 20;\n\nconst depthRules = {\n  quick: 'Return at most 4 findings and only those rated medium severity or higher. Keep explanations to one sentence.',\n  standard: 'Return at most 8 findings, ordered by severity.',\n  deep: 'Return up to 15 findings. Include architectural observations and testing gaps alongside line level issues.',\n};\n\nconst focusRules = {\n  general: 'Weigh correctness, security, performance, readability and testing evenly.',\n  security: 'Prioritize security above all else. Lead with injection, authentication, secrets handling, deserialization, path traversal and access control issues.',\n  performance: 'Prioritize performance above all else. Lead with algorithmic complexity, redundant allocations, N+1 queries, blocking calls in async paths and missing caching.',\n};\n\nconst systemPrompt = [\n  'You are a senior staff engineer performing a rigorous code review.',\n  '',\n  'Review the snippet supplied by the user and reply with a single JSON object matching the required schema. Emit no prose outside the JSON.',\n  '',\n  'Rules:',\n  '1. Judge only what the code actually does. When context is missing, say so inside the finding instead of inventing behaviour.',\n  '2. Every finding must be actionable: name the concrete risk and the concrete fix.',\n  '3. Reserve critical and high severity for security holes, data loss, crashes and incorrect results. A style preference is never high severity.',\n  '4. line_hint must quote a short distinctive fragment of the offending line rather than a line number, because the snippet may be an excerpt.',\n  '5. suggestion should contain a minimal corrected code fragment when a code change is warranted, otherwise a single sentence instruction.',\n  '6. positives must be specific. Skip generic praise. An empty list beats filler.',\n  '7. refactored_snippet should hold the full corrected snippet only when the rewrite is small enough to be useful in one block, otherwise an empty string.',\n  '8. If the input is not code at all, set overall_risk to unknown, explain that in summary and return no findings.',\n  '',\n  depthRules[flags.depth] || depthRules.standard,\n  focusRules[flags.focus] || focusRules.general,\n].join('\\n');\n\nconst userPrompt = [\n  'Declared language: ' + language,\n  'Line count: ' + lineCount,\n  truncated ? 'Note: the snippet was truncated at ' + maxChars + ' characters, so the tail is missing.' : '',\n  '',\n  'Code to review:',\n  '```' + (language === 'unknown' ? '' : language),\n  code,\n  '```',\n].filter(Boolean).join('\\n');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['language', 'summary', 'overall_risk', 'findings', 'positives', 'suggested_tests', 'refactored_snippet'],\n  properties: {\n    language: { type: 'string', description: 'Language actually detected in the snippet.' },\n    summary: { type: 'string', description: 'Two or three sentences on what the code does and its overall health.' },\n    overall_risk: { type: 'string', enum: ['low', 'medium', 'high', 'critical', 'unknown'] },\n    findings: {\n      type: 'array',\n      items: {\n        type: 'object',\n        additionalProperties: false,\n        required: ['severity', 'category', 'title', 'line_hint', 'explanation', 'suggestion'],\n        properties: {\n          severity: { type: 'string', enum: ['critical', 'high', 'medium', 'low', 'nit'] },\n          category: { type: 'string', enum: ['security', 'correctness', 'performance', 'readability', 'testing', 'architecture', 'style'] },\n          title: { type: 'string', description: 'Under ten words.' },\n          line_hint: { type: 'string', description: 'Short quoted fragment of the offending line, or an empty string.' },\n          explanation: { type: 'string' },\n          suggestion: { type: 'string' },\n        },\n      },\n    },\n    positives: { type: 'array', items: { type: 'string' } },\n    suggested_tests: { type: 'array', items: { type: 'string' } },\n    refactored_snippet: { type: 'string' },\n  },\n};\n\nconst payload = {\n  model: cfg.model,\n  models: [cfg.model, cfg.fallbackModel],\n  temperature: Number(cfg.temperature),\n  max_tokens: 4000,\n  response_format: {\n    type: 'json_schema',\n    json_schema: { name: 'code_review', strict: true, schema: schema },\n  },\n  messages: [\n    { role: 'system', content: systemPrompt },\n    { role: 'user', content: userPrompt },\n  ],\n};\n\nreturn [{\n  json: {\n    ok: ok,\n    chatId: msg.chat ? msg.chat.id : null,\n    messageId: msg.message_id || null,\n    userName: (msg.from && (msg.from.username || msg.from.first_name)) || 'there',\n    language: language,\n    lineCount: lineCount,\n    truncated: truncated,\n    flags: flags,\n    payload: payload,\n  },\n}];\n"
      },
