      "parameters": {
        "jsCode": "\n// ---------------------------------------------------------------------------\n// Turns the OpenRouter response into Telegram ready HTML, defensively.\n// Never throws on a malformed model reply, and splits long reviews into\n// ordered chunks that stay under Telegram's 4096 character message limit.\n// ---------------------------------------------------------------------------\n\nconst prep = $('Prepare Review Request').first().json;\nconst res = $json || {};\n\nconst LIMIT = 3600;\nconst RISK_ICON = { critical: '\\u{1F6D1}', high: '\\u{1F534}', medium: '\\u{1F7E0}', low: '\\u{1F7E1}', nit: '\\u26AA', unknown: '\\u2753' };\nconst ORDER = { critical: 0, high: 1, medium: 2, low: 3, nit: 4 };\n\nfunction esc(v) {\n  return String(v === undefined || v === null ? '' : v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nfunction messageText(r) {\n  const choice = r && r.choices && r.choices[0];\n  const content = choice && choice.message ? choice.message.content : '';\n  if (typeof content === 'string') return content;\n  if (Array.isArray(content)) return content.map((p) => p.text || '').join('');\n  return '';\n}\n\nlet raw = messageText(res).trim();\nraw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\n\nlet review = null;\ntry {\n  review = JSON.parse(raw);\n} catch (err) {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start !== -1 && end > start) {\n    try { review = JSON.parse(raw.slice(start, end + 1)); } catch (inner) { review = null; }\n  }\n}\n\nif (!review || typeof review !== 'object') {\n  review = {\n    language: prep.language,\n    summary: raw ? raw.slice(0, 900) : 'The model returned no usable output. Try again, or switch models in the Config node.',\n    overall_risk: 'unknown',\n    findings: [],\n    positives: [],\n    suggested_tests: [],\n    refactored_snippet: '',\n  };\n}\n\nconst findings = Array.isArray(review.findings) ? review.findings.slice() : [];\nfindings.sort((a, b) => (ORDER[a.severity] ?? 9) - (ORDER[b.severity] ?? 9));\n\nconst counts = {};\nfor (const f of findings) counts[f.severity] = (counts[f.severity] || 0) + 1;\nconst countLine = ['critical', 'high', 'medium', 'low', 'nit']\n  .filter((s) => counts[s])\n  .map((s) => RISK_ICON[s] + ' ' + counts[s] + ' ' + s)\n  .join('   ');\n\nconst risk = String(review.overall_risk || 'unknown').toLowerCase();\nconst lang = review.language || prep.language;\n\n// Each entry is one atomic block. Blocks are never split mid tag.\nconst blocks = [];\n\nblocks.push(\n  '<b>Code Review</b>  ' + (RISK_ICON[risk] || RISK_ICON.unknown) + ' <b>' + esc(risk.toUpperCase()) + ' RISK</b>\\n' +\n  '<i>' + esc(lang) + ' \\u00B7 ' + prep.lineCount + ' lines' + (prep.truncated ? ' \\u00B7 truncated' : '') + '</i>'\n);\n\nif (countLine) blocks.push(countLine);\nif (review.summary) blocks.push(esc(review.summary));\n\nif (findings.length) {\n  blocks.push('<b>Findings</b>');\n  findings.forEach((f, i) => {\n    const parts = [\n      (RISK_ICON[f.severity] || RISK_ICON.unknown) + ' <b>' + (i + 1) + '. ' + esc(f.title) + '</b>' +\n      ' <i>(' + esc(f.category) + ')</i>',\n    ];\n    if (f.line_hint) parts.push('<code>' + esc(f.line_hint) + '</code>');\n    if (f.explanation) parts.push(esc(f.explanation));\n    if (f.suggestion) {\n      const multiline = /\\n/.test(f.suggestion) || f.suggestion.length > 90;\n      parts.push(multiline\n        ? '<pre><code>' + esc(f.suggestion) + '</code></pre>'\n        : '\\u{1F4A1} ' + esc(f.suggestion));\n    }\n    blocks.push(parts.join('\\n'));\n  });\n}\n\nif (Array.isArray(review.positives) && review.positives.length) {\n  blocks.push('<b>What works well</b>\\n' + review.positives.map((p) => '\\u2705 ' + esc(p)).join('\\n'));\n}\n\nif (Array.isArray(review.suggested_tests) && review.suggested_tests.length) {\n  blocks.push('<b>Tests worth adding</b>\\n' + review.suggested_tests.map((t) => '\\u{1F9EA} ' + esc(t)).join('\\n'));\n}\n\nif (review.refactored_snippet && review.refactored_snippet.trim()) {\n  blocks.push('<b>Suggested rewrite</b>\\n<pre><code class=\"language-' + esc(lang) + '\">' +\n    esc(review.refactored_snippet.trim()) + '</code></pre>');\n}\n\nconst usage = res.usage || {};\nblocks.push('<i>' + esc(res.model || prep.payload.model) + ' \\u00B7 ' +\n  (usage.total_tokens || 0) + ' tokens</i>');\n\n// Pack blocks into chunks. A single oversized block is hard split as a last resort.\nconst chunks = [];\nlet current = '';\nfor (const block of blocks) {\n  const piece = block.length > LIMIT ? block.slice(0, LIMIT - 20) + '\\n<i>[trimmed]</i>' : block;\n  if (!current) {\n    current = piece;\n  } else if (current.length + piece.length + 2 <= LIMIT) {\n    current += '\\n\\n' + piece;\n  } else {\n    chunks.push(current);\n    current = piece;\n  }\n}\nif (current) chunks.push(current);\n\nreturn chunks.map((chunk, i) => ({\n  json: {\n    chatId: prep.chatId,\n    replyTo: i === 0 ? prep.messageId : null,\n    part: i + 1,\n    parts: chunks.length,\n    chunk: chunks.length > 1 ? chunk + '\\n<i>(' + (i + 1) + '/' + chunks.length + ')</i>' : chunk,\n  },\n}));\n"
      },
